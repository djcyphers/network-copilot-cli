# Environment Variables for Network Copilot CLI
# Copy this file to .env and fill in your values
# WARNING: Never commit .env files with real credentials

# ============================================
# COPILOT CLI AUTHENTICATION
# ============================================
# Copilot CLI uses GitHub OAuth - run "/login" after loading copilot cli (no token file needed)

# ============================================
# MCP SERVER API KEYS (Only needed if using these specific servers)
# ============================================

# GitHub MCP server - for repo/gist operations (optional - uses GitHub CLI auth if available)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily web search - for real-time web research (optional)
# Get key at https://tavily.com (free tier available)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: Network Environment Settings
# ============================================

# MongoDB connection string (if using mongodb MCP server)
# MONGODB_URI=mongodb://username:password@hostname:27017/database

# Default server list for network scripts (comma-separated)
# DEFAULT_SERVERS=SERVER01,SERVER02,SERVER03

# Domain suffix for quick DNS lookups
# DOMAIN_SUFFIX=.contoso.com
